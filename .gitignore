# Compiled binaries and shared libraries — never source, always rebuilt.
*.so
*.dylib
*.dll
*.exe
*.a
*.o

# Go build/test artifacts that sometimes land in-tree.
/photon-bindings/c/photon_test
/photon-bindings/c/leakcheck_handles
/photon-bindings/c/leakcheck_strings
# `go build ./...` в этом каталоге кладёт бинарник по имени модуля. Правила
# на него не было, и его дважды удаляли руками после обычной проверки сборки.
/photon-bindings/c/photon-bindings-c

# Каталог сборки bindings. Собирать .so ТОЛЬКО сюда: -buildmode=c-shared
# кладёт рядом с выходным файлом сгенерённый заголовок, названный по нему, и
# сборка в корень пакета молча затирает photon_core.h — замороженный контракт
# ABI (ADR-008). См. photon-bindings/c/README.md.
/photon-bindings/c/build/

# go.sum is intentionally NOT ignored — it is checked in and reviewed like any
# other dependency-integrity file (see CLAUDE.md, "Замечания по окружению").

# Editor/OS noise.
.DS_Store
*.swp

# Claude Code local tooling config — personal permission allowlist, not
# project source. A future .claude/settings.json (without .local) would be
# the shared, checked-in variant.
.claude/settings.local.json

# Photon Developer Tools — Gradle (ADR-051). Каталог сборки и кэш Gradle не
# являются исходниками: native там пересобирается задачей buildJniLib.
/photon-developer-tools/build/
/photon-developer-tools/.gradle/
# .kotlin/ заводит компилятор Kotlin 2.x — он уже создан в дереве и попал бы
# в untracked, как только в нём появится первый файл.
/photon-developer-tools/.kotlin/

# Photon SDK — Gradle (ADR-062, sdk-api.md §7.3). Отдельная сборка со своим
# корнем, поэтому и свой каталог сборки с кэшем. .kotlin/ добавляется сверх
# пары выше: его заводит компилятор Kotlin 2.x, и в Developer Tools он не
# появлялся.
/photon-sdk/build/
/photon-sdk/.gradle/
/photon-sdk/.kotlin/
